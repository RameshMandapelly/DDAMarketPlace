          "version": "0.2.0",
          "configurations": [
          {
                    "name": "MWFinance.API",
                    "type": "coreclr",
                    "request": "launch",
                    "preLaunchTask": "build",
                    "program": "${workspaceFolder}/MWFinance.API/bin/Debug/net8.0/MWFinance.API.dll",
                    "args": [],
                    "cwd": "${workspaceFolder}/MWFinance.API",
                    "stopAtEntry": false,
                    "serverReadyAction": {
                              "action": "openExternally",
                              "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
                    },
                    "env": {
                              "ASPNETCORE_ENVIRONMENT": "Development"
                    },
                    "console": "integratedTerminal"
          }
          ]
}